---
interface Props { size?: number; class?: string; }
const { size = 26, class: cls = '' } = Astro.props;
const uid = 'pl' + Math.random().toString(36).slice(2, 8);
---
<svg class={cls} width={size} height={size} viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id={`${uid}-s`} x1="22" y1="14" x2="40" y2="30" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#b388ff"></stop>
      <stop offset="0.4" stop-color="#6aa8ff"></stop>
      <stop offset="0.7" stop-color="#28e0c8"></stop>
      <stop offset="1" stop-color="#ffd166"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-t`} x1="6" y1="6" x2="26" y2="34" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#2b3346"></stop>
      <stop offset="1" stop-color="#0f121a"></stop>
    </linearGradient>
  </defs>
  <!-- incoming white beam -->
  <path d="M0 19 L14 20" stroke="#eef3fb" stroke-width="2" stroke-linecap="round" opacity="0.9"></path>
  <!-- refracted spectrum fan -->
  <path d="M20 20 L40 14" stroke="#b388ff" stroke-width="1.6" stroke-linecap="round"></path>
  <path d="M20 20 L40 19" stroke="#6aa8ff" stroke-width="1.6" stroke-linecap="round"></path>
  <path d="M20 20 L40 24" stroke="#28e0c8" stroke-width="1.6" stroke-linecap="round"></path>
  <path d="M20 20 L40 29" stroke="#ffd166" stroke-width="1.6" stroke-linecap="round"></path>
  <!-- the prism -->
  <path d="M14 6 L27 32 L4 30 Z" fill={`url(#${uid}-t)`} stroke="url(#${uid}-s)" stroke-width="1.4" stroke-linejoin="round"></path>
</svg>
