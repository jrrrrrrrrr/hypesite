---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  items?: string[];
  note?: string;
}
const { eyebrow, title, lede, items = [], note } = Astro.props;
---
<section class="wrap section">
  <span class="eyebrow">{eyebrow}</span>
  <h1 class="section-title" style="font-size:clamp(32px,5vw,52px)">{title}</h1>
  <p class="section-lede" style="font-size:17px">{lede}</p>

  <div class="card card-prism soon" style="margin-top:28px">
    <div class="soon-head">
      <span class="badge"><span class="dot"></span>Porting from the legacy terminal</span>
    </div>
    {items.length > 0 && (
      <>
        <p class="soon-sub">This module will surface:</p>
        <ul class="soon-list">
          {items.map((i) => <li>{i}</li>)}
        </ul>
      </>
    )}
    {note && <p class="dim" style="font-size:13px;margin-top:14px">{note}</p>}
    <div class="soon-actions">
      <a href="/" class="btn btn-ghost">← Overview</a>
      <a href="/treasury" class="btn btn-ghost">Treasury</a>
      <a href="/indicators" class="btn btn-primary">Prism indicators →</a>
    </div>
  </div>
</section>

<style>
  .soon { padding: 30px; }
  .soon-head { margin-bottom: 16px; }
  .soon-sub { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 12px; }
  .soon-list { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; }
  .soon-list li { font-size: 14px; color: var(--text-mid); padding-left: 18px; position: relative; }
  .soon-list li::before { content: ''; position: absolute; left: 0; top: 8px; width: 7px; height: 7px; border-radius: 2px; background: var(--prism); }
  .soon-actions { display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
  @media (max-width: 560px) { .soon-list { grid-template-columns: 1fr; } }
</style>
