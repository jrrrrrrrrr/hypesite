---
// Historical buyback / burn charts, sourced from HypurrScan /fees (via /api/hs).
// total_fees is cumulative micro-USD; ~99% of fees fund the Assistance Fund's
// HYPE buybacks (the "holders share"), per the protocol.
---
<div class="bh">
  <div class="bh-head">
    <div class="bh-stats">
      <div><span class="stat-label">Cumulative buybacks</span><span class="bh-v mono" data-live id="bhCum"></span></div>
      <div><span class="stat-label">Last 30d</span><span class="bh-v mono" data-live id="bh30"></span></div>
      <div><span class="stat-label">Last 7d</span><span class="bh-v mono" data-live id="bh7"></span></div>
      <div><span class="stat-label">Last 24h</span><span class="bh-v mono" data-live id="bh24"></span></div>
    </div>
    <div class="bh-range" role="group" aria-label="Time range">
      <button data-range="30" id="bhR30">30d</button>
      <button data-range="90" id="bhR90">90d</button>
      <button data-range="0" class="active" id="bhRAll">All</button>
    </div>
  </div>

  <div class="bh-panel card">
    <div class="bh-clabel">Cumulative fees recycled into HYPE buybacks</div>
    <div class="bh-cwrap"><canvas id="bhCumCanvas"></canvas><div class="bh-empty" id="bhCumEmpty">Loading history…</div></div>
  </div>

  <div class="bh-panel card">
    <div class="bh-clabel">Daily buyback fuel <span class="dim">· each day's fees → HYPE</span></div>
    <div class="bh-bwrap"><canvas id="bhBarCanvas"></canvas></div>
  </div>

  <p class="dim mono bh-note">Source: HypurrScan cumulative fees · buyback ≈ 99% of protocol fees (the holders' share). Early periods are sampled less frequently and spread evenly across days.</p>
</div>

<style>
  .bh-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
  .bh-stats { display: flex; gap: 28px; flex-wrap: wrap; }
  .bh-stats > div { display: flex; flex-direction: column; gap: 4px; }
  .bh-v { font-size: 22px; font-weight: 600; color: var(--text-bright); font-variant-numeric: tabular-nums; }
  #bhCum { color: var(--accent); }
  .bh-range { display: inline-flex; gap: 3px; background: var(--surface-2); border: 1px solid var(--border); border-radius: 999px; padding: 3px; }
  .bh-range button { font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); padding: 6px 12px; border-radius: 999px; transition: all 0.2s; }
  .bh-range button.active { color: #06120f; background: var(--accent); font-weight: 600; }
  .bh-panel { padding: 16px; margin-bottom: 12px; }
  .bh-clabel { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--text-mid); margin-bottom: 10px; text-transform: uppercase; }
  .bh-cwrap, .bh-bwrap { position: relative; }
  #bhCumCanvas { width: 100%; height: 220px; display: block; }
  #bhBarCanvas { width: 100%; height: 150px; display: block; }
  .bh-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 12px; color: var(--text-faint); }
  .bh-note { font-size: 11px; margin-top: 8px; }
</style>

<script>
  import { F } from '../lib/hl';

  const cumCanvas = document.getElementById('bhCumCanvas') as HTMLCanvasElement | null;
  const barCanvas = document.getElementById('bhBarCanvas') as HTMLCanvasElement | null;
  if (cumCanvas && barCanvas) {
    const cc = cumCanvas.getContext('2d')!;
    const bc = barCanvas.getContext('2d')!;
    const PRISM = ['#b388ff', '#6aa8ff', '#28e0c8', '#ffd166'];
    const ratio = (tSec: number) => (tSec > 1756512000 ? 0.99 : 0.97);

    type Pt = { t: number; v: number };
    let cumAll: Pt[] = [];
    let barsAll: Pt[] = [];
    let range = 0;
    let prog = 0, animStart = 0;

    function sizeOf(cv: HTMLCanvasElement, ctx: CanvasRenderingContext2D, h: number) {
      const r = cv.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      if (cv.width !== Math.round(r.width * dpr) || cv.height !== Math.round(h * dpr)) {
        cv.width = Math.round(r.width * dpr); cv.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      return { w: r.width, h };
    }

    function filtered() {
      if (!range) return { cum: cumAll, bars: barsAll };
      const cutoff = Date.now() - range * 86400000;
      return { cum: cumAll.filter((p) => p.t >= cutoff), bars: barsAll.filter((p) => p.t >= cutoff) };
    }

    function drawCum(p: number) {
      const { w, h } = sizeOf(cumCanvas!, cc, 220);
      cc.clearRect(0, 0, w, h);
      const data = filtered().cum;
      if (data.length < 2) return;
      const padT = 12, padB = 18, padL = 6, padR = 12;
      const max = Math.max(...data.map((d) => d.v));
      const yMax = max * 1.06 || 1;
      const x = (i: number) => padL + (i / (data.length - 1)) * (w - padL - padR);
      const y = (v: number) => padT + (1 - (v * p) / yMax) * (h - padT - padB);
      cc.strokeStyle = 'rgba(255,255,255,0.05)';
      for (let g = 0; g <= 3; g++) { const gy = padT + (g / 3) * (h - padT - padB); cc.beginPath(); cc.moveTo(padL, gy); cc.lineTo(w - padR, gy); cc.stroke(); }
      cc.beginPath(); cc.moveTo(x(0), y(data[0].v));
      for (let i = 1; i < data.length; i++) cc.lineTo(x(i), y(data[i].v));
      cc.lineTo(x(data.length - 1), h - padB); cc.lineTo(x(0), h - padB); cc.closePath();
      const fill = cc.createLinearGradient(0, padT, 0, h - padB);
      fill.addColorStop(0, 'rgba(40,224,200,0.26)'); fill.addColorStop(1, 'rgba(40,224,200,0.01)');
      cc.fillStyle = fill; cc.fill();
      const grad = cc.createLinearGradient(padL, 0, w - padR, 0);
      PRISM.forEach((c, i) => grad.addColorStop(i / (PRISM.length - 1), c));
      cc.beginPath(); cc.moveTo(x(0), y(data[0].v));
      for (let i = 1; i < data.length; i++) cc.lineTo(x(i), y(data[i].v));
      cc.strokeStyle = grad; cc.lineWidth = 2.2; cc.lineJoin = 'round';
      cc.shadowColor = 'rgba(40,224,200,0.45)'; cc.shadowBlur = 12; cc.stroke(); cc.shadowBlur = 0;
      cc.fillStyle = 'rgba(147,160,182,0.6)'; cc.font = '10px ui-monospace, monospace'; cc.textAlign = 'left';
      cc.fillText('$' + F.c(max), padL + 2, padT + 2);
      cc.fillText(new Date(data[0].t).toLocaleDateString('en-US', { month: 'short', year: '2-digit' }), padL + 2, h - 5);
      cc.textAlign = 'right';
      cc.fillText(new Date(data[data.length - 1].t).toLocaleDateString('en-US', { month: 'short', year: '2-digit' }), w - padR, h - 5);
    }

    function drawBars(p: number) {
      const { w, h } = sizeOf(barCanvas!, bc, 150);
      bc.clearRect(0, 0, w, h);
      const data = filtered().bars;
      if (!data.length) return;
      const padT = 10, padB = 16, padL = 6, padR = 12;
      const max = Math.max(...data.map((d) => d.v)) || 1;
      const cw = (w - padL - padR) / data.length;
      const bw = Math.max(1, Math.min(cw * 0.8, 14));
      const grad = bc.createLinearGradient(0, padT, 0, h - padB);
      grad.addColorStop(0, '#28e0c8'); grad.addColorStop(1, 'rgba(106,168,255,0.5)');
      for (let i = 0; i < data.length; i++) {
        const bh = ((data[i].v * p) / max) * (h - padT - padB);
        const bx = padL + i * cw + (cw - bw) / 2;
        const by = h - padB - bh;
        bc.fillStyle = i === data.length - 1 ? '#eafff9' : grad;
        bc.beginPath();
        const rr = Math.min(2, bw / 2);
        bc.roundRect(bx, by, bw, Math.max(0, bh), [rr, rr, 0, 0]);
        bc.fill();
      }
      bc.fillStyle = 'rgba(147,160,182,0.6)'; bc.font = '10px ui-monospace, monospace'; bc.textAlign = 'left';
      bc.fillText('peak $' + F.c(max) + '/day', padL + 2, padT + 2);
    }

    function animate(ts: number) {
      if (!animStart) animStart = ts;
      prog = Math.min(1, (ts - animStart) / 700);
      const e = 1 - Math.pow(1 - prog, 3);
      drawCum(e); drawBars(e);
      if (prog < 1) requestAnimationFrame(animate);
    }
    function reanimate() { animStart = 0; prog = 0; requestAnimationFrame(animate); }

    function process(items: any[]) {
      const sorted = items
        .map((x) => ({ t: Number(x.time), fees: Number(x.total_fees) / 1e6 }))
        .filter((x) => isFinite(x.t) && isFinite(x.fees))
        .sort((a, b) => a.t - b.t);
      if (sorted.length < 2) return;
      let cum = sorted[0].fees * ratio(sorted[0].t);
      cumAll = [{ t: sorted[0].t * 1000, v: cum }];
      const dayMap: Record<number, number> = {};
      for (let i = 1; i < sorted.length; i++) {
        const d = (sorted[i].fees - sorted[i - 1].fees) * ratio(sorted[i].t);
        cum += Math.max(0, d);
        cumAll.push({ t: sorted[i].t * 1000, v: cum });
        const d0 = Math.floor(sorted[i - 1].t / 86400), d1 = Math.floor(sorted[i].t / 86400);
        if (d1 <= d0) { dayMap[d1] = (dayMap[d1] || 0) + Math.max(0, d); }
        else { const per = Math.max(0, d) / (d1 - d0); for (let dd = d0 + 1; dd <= d1; dd++) dayMap[dd] = (dayMap[dd] || 0) + per; }
      }
      barsAll = Object.keys(dayMap).map((k) => ({ t: Number(k) * 86400000, v: dayMap[Number(k)] })).sort((a, b) => a.t - b.t);
      const setT = (id: string, v: string) => { const e = document.getElementById(id); if (e) e.textContent = v; };
      setT('bhCum', F.uc(cum));
      const now = Date.now();
      const sumSince = (days: number) => barsAll.filter((b) => b.t >= now - days * 86400000).reduce((s, b) => s + b.v, 0);
      setT('bh30', F.uc(sumSince(30)));
      setT('bh7', F.uc(sumSince(7)));
      setT('bh24', F.uc(barsAll.length ? barsAll[barsAll.length - 1].v : 0));
      const emp = document.getElementById('bhCumEmpty'); if (emp) emp.style.display = 'none';
      reanimate();
    }

    async function load() {
      try {
        const r = await fetch('/api/hs?path=/fees');
        if (!r.ok) throw new Error('hs ' + r.status);
        const items = await r.json();
        if (Array.isArray(items) && items.length) process(items);
        else throw new Error('empty');
      } catch {
        const emp = document.getElementById('bhCumEmpty'); if (emp) emp.textContent = 'Couldn’t load history right now.';
      }
    }

    document.querySelectorAll('.bh-range button').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('.bh-range button').forEach((x) => x.classList.remove('active'));
      b.classList.add('active');
      range = Number((b as HTMLElement).dataset.range) || 0;
      reanimate();
    }));
    window.addEventListener('resize', () => { drawCum(1); drawBars(1); });

    load();
    setInterval(load, 120000);
  }
</script>
