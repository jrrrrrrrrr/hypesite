---
import Layout from '../layouts/Layout.astro';
import BuybackLive from '../components/BuybackLive.astro';
import BurnHistory from '../components/BurnHistory.astro';
import { INDICATORS } from '../lib/indicators';
const featured = INDICATORS.slice(0, 4);
---
<Layout path="/">
  <!-- ============ HERO ============ -->
  <section class="hero wrap">
    <div class="hero-copy reveal">
      <span class="eyebrow">Hyperliquid · Live intelligence</span>
      <h1 class="hero-title">
        The <span class="prism-text">Hyperliquid</span><br />
        intelligence terminal.
      </h1>
      <p class="section-lede" style="margin-top:18px">
        Real-time HYPE price, perp &amp; spot volume, open interest, the fee buyback engine,
        staking, holders and HIP-3 markets — plus the
        <a href="/indicators" style="color:var(--accent)">Prism</a> suite of TradingView indicators.
      </p>
      <div class="hero-cta">
        <a href="/burns" class="btn btn-primary">Watch the buyback engine →</a>
        <a href="/indicators" class="btn">Shop Prism indicators</a>
      </div>
    </div>

    <div class="hero-price card card-prism reveal" style="animation-delay:.08s">
      <div class="hp-top">
        <span class="badge badge-live"><span class="dot"></span>Live</span>
        <span class="stat-label">HYPE / USD</span>
      </div>
      <div class="hp-price mono" data-live id="ovPrice"></div>
      <div class="hp-chg mono" id="ovChg"></div>
      <canvas id="ovSpark" class="hp-spark"></canvas>
      <div class="hp-mini">
        <div><span class="stat-label">Mkt cap</span><span class="mono" data-live id="ovMcap"></span></div>
        <div><span class="stat-label">24h vol</span><span class="mono" data-live id="ovCgVol"></span></div>
        <div><span class="stat-label">ATH</span><span class="mono" data-live id="ovAth"></span></div>
      </div>
    </div>
  </section>

  <!-- ============ DENSE LIVE STATS ============ -->
  <section class="wrap section-sm">
    <div class="cluster-label">Market &amp; volume</div>
    <div class="grid grid-4">
      <div class="card stat"><div class="stat-label">Perp volume · 24h</div><div class="stat-value" data-live id="ovPerpVol"></div><div class="stat-sub">Σ all HL perps</div></div>
      <div class="card stat"><div class="stat-label">Spot volume · 24h</div><div class="stat-value" data-live id="ovSpotVol"></div><div class="stat-sub">HL spot pairs</div></div>
      <div class="card stat"><div class="stat-label">Open interest</div><div class="stat-value" data-live id="ovOi"></div><div class="stat-sub">notional, USD</div></div>
      <div class="card stat"><div class="stat-label">Perp markets</div><div class="stat-value" data-live id="ovMkts"></div><div class="stat-sub">listed on HL</div></div>
    </div>

    <div class="cluster-label">Supply &amp; burns</div>
    <div class="grid grid-4">
      <div class="card stat"><div class="stat-label">Circulating</div><div class="stat-value" data-live id="ovSupply"></div><div class="stat-sub">of 1B max HYPE</div></div>
      <div class="card stat"><div class="stat-label">Held by AF</div><div class="stat-value" data-live id="ovAfHype"></div><div class="stat-sub">HYPE in the Assistance Fund</div></div>
      <div class="card stat"><div class="stat-label">AF fund value</div><div class="stat-value" data-live id="ovAfUsd"></div><div class="stat-sub">USD value of the stack</div></div>
      <div class="card stat"><div class="stat-label">Supply removed</div><div class="stat-value" data-live id="ovBurnPct"></div><div class="stat-sub">AF + fee burns, % of max</div></div>
    </div>

    <div class="cluster-label">Fees &amp; buybacks</div>
    <div class="grid grid-4">
      <div class="card stat"><div class="stat-label">Fees · 24h</div><div class="stat-value" data-live id="ovFees24"></div><div class="stat-sub">→ HYPE buybacks</div></div>
      <div class="card stat"><div class="stat-label">Fees · 7d</div><div class="stat-value" data-live id="ovFees7"></div><div class="stat-sub">→ HYPE buybacks</div></div>
      <div class="card stat"><div class="stat-label">Fees · all-time</div><div class="stat-value" data-live id="ovFeesCum"></div><div class="stat-sub">cumulative since launch</div></div>
      <div class="card stat"><div class="stat-label">Fee burns</div><div class="stat-value" data-live id="ovFeeBurn"></div><div class="stat-sub">HYPE, protocol-level</div></div>
    </div>

    <div class="cluster-label">Staking &amp; network</div>
    <div class="grid grid-4">
      <div class="card stat"><div class="stat-label">Staked</div><div class="stat-value" data-live id="ovStaked"></div><div class="stat-sub">HYPE delegated</div></div>
      <div class="card stat"><div class="stat-label">Staking ratio</div><div class="stat-value" data-live id="ovStakePct"></div><div class="stat-sub">of circulating</div></div>
      <div class="card stat"><div class="stat-label">Validators</div><div class="stat-value" data-live id="ovVals"></div><div class="stat-sub">active set</div></div>
      <div class="card stat" id="cardHolders"><div class="stat-label">HYPE holders</div><div class="stat-value" data-live id="ovHolders"></div><div class="stat-sub">on HyperCore</div></div>
    </div>
  </section>

  <!-- ============ LIVE BUYBACK ENGINE ============ -->
  <section class="wrap section">
    <div class="ind-head">
      <div>
        <span class="eyebrow">Buyback engine · live</span>
        <h2 class="section-title">Watch the burn, in real time.</h2>
        <p class="section-lede">The Assistance Fund converts trading fees into HYPE and holds it — effectively removing it from supply. This samples the fund live; the chart climbs as buybacks land.</p>
      </div>
      <a href="/burns" class="btn btn-ghost">Full tracker →</a>
    </div>
    <div style="margin-top:24px"><BuybackLive /></div>
    <div style="margin-top:16px"><BurnHistory /></div>
  </section>

  <!-- ============ INDICATORS TEASER ============ -->
  <section class="wrap section">
    <div class="ind-head">
      <div>
        <span class="eyebrow">Prism suite · TradingView</span>
        <h2 class="section-title">Indicators built on this desk.</h2>
      </div>
      <a href="/indicators" class="btn btn-ghost">View all →</a>
    </div>
    <div class="grid grid-4" style="margin-top:22px">
      {featured.map((ind, i) => (
        <a href="/indicators" class="card card-hover ind-mini" style={`--ac:${ind.accent}`}>
          <div class="ind-mini-img"><img src={ind.image} alt={ind.name} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" /></div>
          <div class="ind-mini-body">
            <span class="ind-badge">{ind.badge}</span>
            <h3 class="ind-mini-name">{ind.name}</h3>
            <p class="ind-mini-tag">{ind.tagline}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 40px; align-items: center; padding-top: 64px; padding-bottom: 28px; }
  .hero-title { font-size: clamp(40px, 6vw, 76px); font-weight: 800; letter-spacing: -0.04em; }
  .hero-cta { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }

  .hero-price { padding: 26px; }
  .hp-top { display: flex; align-items: center; justify-content: space-between; }
  .hp-price { font-size: 52px; font-weight: 600; letter-spacing: -0.03em; margin-top: 14px; color: var(--text-bright); }
  .hp-chg { font-size: 16px; margin-top: 2px; }
  .hp-spark { width: 100%; height: 46px; display: block; margin-top: 14px; }
  .hp-mini { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }
  .hp-mini > div { display: flex; flex-direction: column; gap: 4px; }
  .hp-mini .mono { font-size: 14px; color: var(--text); }

  .cluster-label { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-dim); margin: 26px 0 12px; display: flex; align-items: center; gap: 9px; }
  .cluster-label::before { content: ''; width: 16px; height: 2px; border-radius: 2px; background: var(--prism); }
  .cluster-label:first-child { margin-top: 4px; }
  .stat .stat-value { font-size: 23px; }

  .ind-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .ind-mini { padding: 0; overflow: hidden; --ac: var(--accent); }
  .ind-mini-img { aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg-2); border-bottom: 1px solid var(--border); }
  .ind-mini-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease); }
  .ind-mini:hover .ind-mini-img img { transform: scale(1.05); }
  .ind-mini-body { padding: 16px; }
  .ind-badge { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ac); border: 1px solid color-mix(in srgb, var(--ac) 35%, transparent); padding: 2px 7px; border-radius: 5px; }
  .ind-mini-name { font-size: 17px; margin: 10px 0 6px; }
  .ind-mini-tag { font-size: 13px; color: var(--text-mid); line-height: 1.5; }

  @media (max-width: 920px) {
    .hero { grid-template-columns: 1fr; }
    .hero-price { max-width: 460px; }
  }
</style>

<script>
  const AF = '0xfefefefefefefefefefefefefefefefefefefefe';
  const MAXS = 1e9;
  let circ = null, price = null, afHype = null, feeBurns = null, staked = null, lastSpark = null;

  function setText(id, v) { const el = document.getElementById(id); if (el) el.textContent = v; }
  function hideCard(id) { const el = document.getElementById(id); if (el) el.style.display = 'none'; }
  function compactUsd(n) { return (n == null || !isFinite(n)) ? '—' : '$' + compact(n); }
  function compact(n) {
    if (n == null || !isFinite(n)) return '—';
    const a = Math.abs(n), s = n < 0 ? '-' : '';
    if (a >= 1e9) return s + (a / 1e9).toFixed(2) + 'B';
    if (a >= 1e6) return s + (a / 1e6).toFixed(2) + 'M';
    if (a >= 1e3) return s + (a / 1e3).toFixed(1) + 'K';
    return s + a.toLocaleString('en-US', { maximumFractionDigits: 2 });
  }
  function stakeDivisor(raw) { for (const t of [1, 1e2, 1e4, 1e6, 1e8, 1e10, 1e12, 1e14, 1e16, 1e18]) { const x = raw / t; if (x >= 1e7 && x <= 1e9) return t; } return 1; }
  async function postHl(body) { const r = await fetch('/api/hl', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }); if (!r.ok) throw new Error('hl'); return r.json(); }

  function recompute() {
    if (afHype != null && price != null) setText('ovAfUsd', compactUsd(afHype * price));
    if (afHype != null || feeBurns != null) { const rem = (afHype || 0) + (feeBurns || 0); setText('ovBurnPct', ((rem / MAXS) * 100).toFixed(2) + '%'); }
    if (staked != null && circ) setText('ovStakePct', ((staked / circ) * 100).toFixed(1) + '%');
  }

  function drawSpark(prices) {
    const cv = document.getElementById('ovSpark'); if (!cv || !Array.isArray(prices) || prices.length < 2) return;
    lastSpark = prices;
    const ctx = cv.getContext('2d'); const rect = cv.getBoundingClientRect(); const dpr = window.devicePixelRatio || 1;
    cv.width = Math.round(rect.width * dpr); cv.height = Math.round(rect.height * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const w = rect.width, h = rect.height;
    const min = Math.min.apply(null, prices), max = Math.max.apply(null, prices), rng = (max - min) || 1;
    const up = prices[prices.length - 1] >= prices[0], col = up ? '#28e0c8' : '#ff6b8b';
    ctx.clearRect(0, 0, w, h);
    const X = (i) => (i / (prices.length - 1)) * w, Y = (p) => h - 3 - ((p - min) / rng) * (h - 6);
    ctx.beginPath(); ctx.moveTo(X(0), Y(prices[0])); for (let i = 1; i < prices.length; i++) ctx.lineTo(X(i), Y(prices[i]));
    ctx.lineTo(w, h); ctx.lineTo(0, h); ctx.closePath();
    const g = ctx.createLinearGradient(0, 0, 0, h); g.addColorStop(0, up ? 'rgba(40,224,200,0.22)' : 'rgba(255,107,139,0.22)'); g.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = g; ctx.fill();
    ctx.beginPath(); ctx.moveTo(X(0), Y(prices[0])); for (let i = 1; i < prices.length; i++) ctx.lineTo(X(i), Y(prices[i]));
    ctx.strokeStyle = col; ctx.lineWidth = 1.6; ctx.stroke();
  }

  async function loadCg() {
    try {
      const r = await fetch('/api/cg?id=hyperliquid'); if (!r.ok) return;
      const d = (await r.json())?.[0]; if (!d) return;
      price = Number(d.current_price);
      setText('ovPrice', '$' + price.toLocaleString('en-US', { maximumFractionDigits: price < 10 ? 4 : 2 }));
      const chg = Number(d.price_change_percentage_24h), c = document.getElementById('ovChg');
      if (c && isFinite(chg)) { c.textContent = (chg >= 0 ? '▲ +' : '▼ ') + chg.toFixed(2) + '%'; c.className = 'hp-chg mono ' + (chg >= 0 ? 'up' : 'down'); }
      setText('ovMcap', compactUsd(Number(d.market_cap)));
      setText('ovCgVol', compactUsd(Number(d.total_volume)));
      setText('ovAth', '$' + Number(d.ath).toLocaleString('en-US', { maximumFractionDigits: 2 }));
      circ = Number(d.circulating_supply); setText('ovSupply', compact(circ));
      if (d.sparkline_in_7d && Array.isArray(d.sparkline_in_7d.price)) drawSpark(d.sparkline_in_7d.price);
      recompute();
    } catch {}
  }

  async function loadPerps() {
    try {
      const data = await postHl({ type: 'metaAndAssetCtxs' });
      const meta = data?.[0]?.universe ?? [], ctxs = data?.[1] ?? [];
      let vol = 0, oi = 0;
      for (let i = 0; i < ctxs.length; i++) {
        const c = ctxs[i] || {}; const v = Number(c.dayNtlVlm); if (isFinite(v)) vol += v;
        const o = Number(c.openInterest), px = Number(c.oraclePx ?? c.markPx); if (isFinite(o) && isFinite(px)) oi += o * px;
      }
      setText('ovPerpVol', compactUsd(vol)); setText('ovOi', compactUsd(oi)); setText('ovMkts', String(meta.length || ctxs.length || '—'));
    } catch {}
  }

  async function loadSpot() {
    try {
      const data = await postHl({ type: 'spotMetaAndAssetCtxs' });
      const ctxs = Array.isArray(data) ? (data[1] || []) : [];
      let svol = 0; ctxs.forEach((c) => { const v = Number(c.dayNtlVlm); if (isFinite(v)) svol += v; });
      setText('ovSpotVol', compactUsd(svol));
      const hy = ctxs.find((c) => c.coin === '@107' || c.coin === 'HYPE/USDC') || ctxs[107];
      if (hy && hy.totalSupply) { const ts = Number(hy.totalSupply); if (ts > 0 && ts < MAXS) { feeBurns = MAXS - ts; setText('ovFeeBurn', compact(feeBurns) + ' HYPE'); recompute(); } }
    } catch {}
  }

  async function loadStaking() {
    try {
      const vals = await postHl({ type: 'validatorSummaries' });
      if (Array.isArray(vals) && vals.length) {
        let raw = 0; vals.forEach((v) => (raw += parseFloat(v.stake || 0)));
        staked = raw / stakeDivisor(raw);
        setText('ovStaked', compact(staked) + ' HYPE'); setText('ovVals', String(vals.length)); recompute();
      }
    } catch {}
  }

  async function loadAf() {
    try {
      const s = await postHl({ type: 'spotClearinghouseState', user: AF });
      if (s && s.balances) { const h = s.balances.find((b) => b.coin === 'HYPE' || b.token === 150); if (h) { afHype = parseFloat(h.total ?? h.hold ?? 0); setText('ovAfHype', compact(afHype) + ' HYPE'); recompute(); } }
    } catch {}
  }

  async function loadFees() {
    try {
      const r = await fetch('/api/hs?path=/fees'); if (!r.ok) return;
      const items = await r.json(); if (!Array.isArray(items) || !items.length) return;
      const sorted = items.map((x) => ({ t: Number(x.time), f: Number(x.total_fees) / 1e6 })).filter((x) => isFinite(x.t) && isFinite(x.f)).sort((a, b) => a.t - b.t);
      const last = sorted[sorted.length - 1].f;
      const at = (agoSec) => { const target = Date.now() / 1000 - agoSec; let best = sorted[0]; for (const it of sorted) { if (it.t <= target) best = it; else break; } return best.f; };
      setText('ovFeesCum', compactUsd(last));
      setText('ovFees24', compactUsd(Math.max(0, last - at(86400))));
      setText('ovFees7', compactUsd(Math.max(0, last - at(7 * 86400))));
    } catch {}
  }

  async function loadHolders() {
    try {
      const r = await fetch('/api/hs?path=/holdersStats'); if (!r.ok) { hideCard('cardHolders'); return; }
      const d = await r.json(); let n = null;
      if (typeof d === 'number') n = d;
      else if (Array.isArray(d)) n = d.length;
      else if (d) n = Number(d.holders ?? d.numHolders ?? d.holdersCount ?? d.count ?? d.total ?? NaN);
      if (n && isFinite(n) && n > 0) setText('ovHolders', compact(n)); else hideCard('cardHolders');
    } catch { hideCard('cardHolders'); }
  }

  window.addEventListener('resize', () => { if (lastSpark) drawSpark(lastSpark); });

  loadCg(); loadPerps(); loadSpot(); loadStaking(); loadAf(); loadFees(); loadHolders();
  setInterval(loadCg, 30000);
  setInterval(loadPerps, 30000);
  setInterval(loadSpot, 45000);
  setInterval(loadStaking, 60000);
  setInterval(loadAf, 30000);
  setInterval(loadFees, 120000);
  setInterval(loadHolders, 300000);
</script>
