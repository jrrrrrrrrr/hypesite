---
import Layout from '../layouts/Layout.astro';
import BuybackLive from '../components/BuybackLive.astro';
import BurnHistory from '../components/BurnHistory.astro';
import LiveFurnace from '../components/LiveFurnace.astro';
import BurnMilestone from '../components/BurnMilestone.astro';
---
<Layout title="Burns" path="/burns" description="Watch HYPE burn live — the Assistance Fund monitor, session burn counters, full buyback history, supply breakdown, and the AQAv2 reserve-yield stream.">
  <section class="wrap section">
    <span class="eyebrow">Buyback engine · live</span>
    <h1 class="section-title" style="font-size:clamp(32px,5vw,52px)">Watch the <span class="prism-text">burn</span>, live.</h1>
    <p class="section-lede" style="font-size:16px">
      Most Hyperliquid trading fees are recycled into HYPE through the Assistance Fund — formally recognized
      as burned by community vote. The monitor samples the fund every 5 seconds: fees arrive as USDC, buybacks
      land as HYPE, and the session counters move the moment they do.
    </p>
    <div style="margin-top:26px"><LiveFurnace /></div>
    <div style="margin-top:14px"><BurnMilestone /></div>
    <div style="margin-top:14px"><BuybackLive showAddr={true} /></div>
  </section>

  <section class="wrap section-sm">
    <h2 class="blk-title">📜 Buyback history</h2>
    <BurnHistory />
  </section>

  <!-- ============ SUPPLY RING ============ -->
  <section class="wrap section-sm">
    <div class="card ring-card">
      <h2 class="blk-title" style="margin-bottom:18px">🍩 Supply breakdown</h2>
      <div class="ring-flex">
        <canvas id="ringCanvas" width="200" height="200"></canvas>
        <div class="ring-legend mono">
          <div class="rl-row"><i style="background:#00d4ff"></i><span>Unstaked circulating</span><b data-live id="lgCirc">—</b></div>
          <div class="rl-row"><i style="background:#00e676"></i><span>Staked by holders</span><b data-live id="lgStaked">—</b></div>
          <div class="rl-row"><i style="background:#ff6b2b"></i><span>Burned</span><b data-live id="lgBurned">—</b></div>
          <div class="rl-row"><i style="background:#2e3448"></i><span>Locked / Foundation</span><b data-live id="lgOther">—</b></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AQAv2 RESERVE-YIELD STREAM ============ -->
  <section class="wrap section-sm">
    <span class="eyebrow">Second buyback stream</span>
    <h2 class="section-title" style="font-size:clamp(24px,3vw,34px)">AQAv2 reserve-yield buybacks.</h2>
    <p class="section-lede">
      Beyond trading fees, most of the yield earned on USDC reserves held on Hyperliquid is routed into the same
      buyback machinery under the AQAv2 framework. It's an estimate, not an on-chain meter — size it with the
      sliders and see it stacked on the live fee buybacks above.
    </p>
    <div class="grid grid-2" style="margin-top:22px">
      <div class="card">
        <div class="aq-label">USDC on Hyperliquid <b id="aqUsdcL">$5.5B</b></div>
        <input id="aqUsdc" type="range" min="1" max="12" step="0.5" value="5.5" />
        <div class="aq-label">Reserve yield · APY <b id="aqYieldL">4.0%</b></div>
        <input id="aqYield" type="range" min="0" max="8" step="0.1" value="4" />
        <div class="aq-label">Share routed to protocol <b id="aqShareL">90%</b></div>
        <input id="aqShare" type="range" min="0" max="100" step="5" value="90" />
        <p class="dim mono" style="font-size:11px;margin-top:4px">Defaults reflect public reporting around AQAv2; USDC balances and yields move.</p>
      </div>
      <div class="card card-prism">
        <div class="stat-label">AQAv2 buyback fuel · annualized (est.)</div>
        <div class="bigval mono" id="aqOut">—</div>
        <div class="aq-split">
          <div><span class="stat-label">+ fee buybacks · annualized run-rate</span><span class="mono" data-live id="aqFee">—</span></div>
        </div>
        <div class="stat-label" style="margin-top:16px">Combined annual buyback fuel (est.)</div>
        <div class="bigval mono" id="aqTotal" style="color:var(--accent)">—</div>
        <div class="stat-sub">estimate only · stacks on the live fee buybacks above</div>
      </div>
    </div>
  </section>

  <section class="wrap section-sm">
    <p class="dim mono" style="font-size:11px">
      AF HYPE was formally recognised as effectively burned by community vote. Live figures update from on-chain
      state; session counters and the monitor chart begin when you open the page. Buyback-fuel figures derive from
      HypurrScan fee data and are approximate.
    </p>
  </section>
</Layout>

<style>
  .blk-title { font-size: 19px; margin-bottom: 16px; }
  .ring-card { padding: 22px 24px; }
  .ring-flex { display: flex; align-items: center; gap: 34px; flex-wrap: wrap; }
  #ringCanvas { width: 200px; height: 200px; flex: 0 0 auto; }
  .ring-legend { display: flex; flex-direction: column; gap: 10px; font-size: 12px; min-width: 280px; flex: 1; }
  .rl-row { display: flex; align-items: center; gap: 10px; }
  .rl-row i { width: 10px; height: 10px; border-radius: 3px; flex: 0 0 auto; }
  .rl-row span { color: var(--text-mid); }
  .rl-row b { margin-left: auto; color: var(--text-bright); font-weight: 600; font-variant-numeric: tabular-nums; }

  .aq-label { display: flex; justify-content: space-between; font-size: 13px; color: var(--text-mid); margin-bottom: 2px; }
  .aq-label b { color: var(--text-bright); font-family: var(--font-mono); }
  input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 5px; border-radius: 999px; background: var(--surface-3); outline: none; margin: 6px 0 18px; }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%; background: var(--accent); cursor: pointer; box-shadow: 0 0 0 4px rgba(0, 212, 255, 0.18); }
  input[type=range]::-moz-range-thumb { width: 16px; height: 16px; border: none; border-radius: 50%; background: var(--accent); cursor: pointer; }
  .bigval { font-size: 30px; font-weight: 600; color: var(--text-bright); margin-top: 6px; font-variant-numeric: tabular-nums; }
  .aq-split { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); }
  .aq-split > div { display: flex; flex-direction: column; gap: 4px; }
  .aq-split .mono { font-size: 18px; color: var(--text); }
  @media (max-width: 640px) { .ring-flex { justify-content: center; } }
</style>

<script>
  import { hlInfo, stakeDivisor, MAX_SUPPLY, F, setText } from '../lib/hl';

  const D: any = ((window as any).HYPE_D = (window as any).HYPE_D || {});
  let cgCirc: number | null = null;

  // ── Supply ring (ported from the original drawRing) ──
  function drawRing() {
    const cv = document.getElementById('ringCanvas') as HTMLCanvasElement | null;
    if (!cv) return;
    const ctx = cv.getContext('2d'); if (!ctx) return;
    const circ = D.circSupply || cgCirc;
    if (!circ) return;
    const burned = (D.afHype || 0) + (D.feesBurned || 0);
    const pub = D.publicStaked || 0;
    const locked = Math.max(0, MAX_SUPPLY - circ - burned);
    const unst = Math.max(0, circ - pub);
    setText('lgCirc', F.hype(unst));
    setText('lgStaked', F.hype(pub));
    setText('lgBurned', F.hype(burned));
    setText('lgOther', F.hype(locked));
    const sz = 200, dpr = window.devicePixelRatio || 1;
    cv.width = sz * dpr; cv.height = sz * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, sz, sz);
    const segs = [
      { v: unst, c: '#00d4ff' },
      { v: pub, c: '#00e676' },
      { v: burned, c: '#ff6b2b' },
      { v: locked, c: '#2e3448' },
    ];
    const total = segs.reduce((s, x) => s + x.v, 0) || 1;
    const cx = sz / 2, cy = sz / 2, r = 75;
    let a = -Math.PI / 2;
    for (const s of segs) {
      const sw = (s.v / total) * Math.PI * 2;
      if (sw < 0.002) continue;
      ctx.beginPath(); ctx.arc(cx, cy, r, a, a + sw);
      ctx.strokeStyle = s.c; ctx.lineWidth = 24; ctx.lineCap = 'butt'; ctx.stroke();
      a += sw;
    }
  }

  async function loadRingData() {
    try {
      const r = await fetch('/api/cg?id=hyperliquid');
      if (r.ok) { const d = (await r.json())?.[0]; const c = Number(d?.circulating_supply); if (isFinite(c)) cgCirc = c; }
    } catch {}
    try {
      const vals = await hlInfo<any[]>({ type: 'validatorSummaries' });
      if (Array.isArray(vals) && vals.length) {
        let raw = 0; vals.forEach((v) => (raw += parseFloat(v.stake || 0)));
        const div = stakeDivisor(raw);
        let total = 0, fnd = 0, pub = 0;
        vals.forEach((v) => {
          const s = parseFloat(v.stake || 0) / div;
          total += s;
          const nm = (v.name || '').toLowerCase();
          if (nm.includes('hyper foundation') || nm.includes('hyperfoundation')) fnd += s; else pub += s;
        });
        D.staked = total; D.publicStaked = pub; D.foundationStaked = fnd;
      }
    } catch {}
    drawRing();
  }
  window.addEventListener('hype:tick', drawRing);
  loadRingData();
  setInterval(loadRingData, 60000);

  // ── AQAv2 estimator ──
  let feeAnnual: number | null = null;
  async function feeRunRate() {
    try {
      const r = await fetch('/api/hs?path=/fees'); if (!r.ok) return;
      const items = await r.json(); if (!Array.isArray(items) || !items.length) return;
      const s = items.map((x: any) => ({ t: Number(x.time), f: Number(x.total_fees) / 1e6 })).filter((x) => isFinite(x.t) && isFinite(x.f)).sort((a, b) => a.t - b.t);
      const last = s[s.length - 1].f;
      const target = Date.now() / 1000 - 30 * 86400; let best = s[0];
      for (const it of s) { if (it.t <= target) best = it; else break; }
      const d30 = Math.max(0, last - best.f);
      feeAnnual = (d30 * 365) / 30;
      recalc();
    } catch {}
  }
  function recalc() {
    const usdc = parseFloat((document.getElementById('aqUsdc') as HTMLInputElement).value);
    const yld = parseFloat((document.getElementById('aqYield') as HTMLInputElement).value);
    const share = parseFloat((document.getElementById('aqShare') as HTMLInputElement).value);
    setText('aqUsdcL', '$' + usdc.toFixed(1) + 'B');
    setText('aqYieldL', yld.toFixed(1) + '%');
    setText('aqShareL', share.toFixed(0) + '%');
    const aq = usdc * 1e9 * (yld / 100) * (share / 100);
    setText('aqOut', F.uc(aq));
    setText('aqFee', feeAnnual != null ? F.uc(feeAnnual) : '…');
    setText('aqTotal', F.uc(aq + (feeAnnual || 0)));
  }
  ['aqUsdc', 'aqYield', 'aqShare'].forEach((id) => document.getElementById(id)?.addEventListener('input', recalc));
  recalc();
  feeRunRate();
  setInterval(feeRunRate, 120000);
</script>
